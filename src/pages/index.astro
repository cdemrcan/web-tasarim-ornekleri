---
import { href } from '../lib/paths';

const samples = [
  {
    path: 'john-remy',
    name: 'John Remy',
    kind: 'Sanatçı portfolyosu',
    summary: 'Eser galerisi, eser detay sayfaları, hakkında ve iletişim formu.',
  },
  {
    path: 'restoran',
    name: 'Közde Ocakbaşı',
    kind: 'Restoran sitesi (kurgusal işletme)',
    summary: 'Sekmeli menü, rezervasyon formu, iletişim ve ulaşım sayfası.',
  },
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Web tasarım örnekleri | John Remy</title>
    <meta name="description" content="John Remy'nin tasarlayıp geliştirdiği web sitesi örnekleri." />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <link rel="icon" href={href('favicon-john-remy.svg')} type="image/svg+xml" />
    <style>
      :root {
        color-scheme: light;
      }
      body {
        margin: 0;
        background: #ffffff;
        color: #15171a;
        font: 1.0625rem/1.6 system-ui, -apple-system, 'Segoe UI', sans-serif;
      }
      main {
        width: min(100% - 2rem, 48rem);
        margin: 0 auto;
        padding: 4rem 0;
      }
      h1 {
        font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
        line-height: 1.1;
        margin: 0 0 0.75rem;
      }
      p {
        margin: 0;
        color: #4b5159;
      }
      ul {
        list-style: none;
        margin: 3rem 0 0;
        padding: 0;
        border-top: 1px solid #d9dce0;
      }
      li {
        border-bottom: 1px solid #d9dce0;
      }
      a {
        display: block;
        padding: 1.25rem 0;
        color: inherit;
        text-decoration: none;
      }
      a:hover strong {
        text-decoration: underline;
      }
      a:focus-visible {
        outline: 3px solid #0b5fff;
        outline-offset: 2px;
      }
      strong {
        display: block;
        font-size: 1.375rem;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Web tasarım örnekleri</h1>
      <p>Her biri ayrı bir görsel kimlikle tasarlanıp geliştirilen örnek siteler.</p>
      <ul>
        {
          samples.map((s) => (
            <li>
              <a href={href(s.path)}>
                <strong>{s.name}</strong>
                <span>{s.kind}. {s.summary}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
